{
  "Keycloak": {
    "AuthServerUrl": "http://keycloak:8080",
    "Realm": "auth-service",
    "Resource": "auth-service",
    "SslRequired": "none",
    "VerifyTokenAudience": true,
    "ConfidentialPort": 0,
    "Audience": "account"
  },
  
  "JwtTokenValidation": {
    "ValidateIssuer": true,
    "ValidateLifetime": true,
    "ValidateAudience": true,
    "ValidIssuer": "http://localhost:8080/realms/auth-service"
  }
}